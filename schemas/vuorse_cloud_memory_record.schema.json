{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuorse-vortex.local/schemas/vuorse_cloud_memory_record.schema.json",
  "$defs": {
    "BehaviorPolicy": {
      "additionalProperties": false,
      "properties": {
        "may_state_as_fact": {
          "title": "May State As Fact",
          "type": "boolean"
        },
        "may_use_for_voice": {
          "title": "May Use For Voice",
          "type": "boolean"
        },
        "may_reveal_to_user": {
          "title": "May Reveal To User",
          "type": "boolean"
        },
        "allowed_surface_form": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Surface Form"
        },
        "promotion_authority": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Authority"
        }
      },
      "required": [
        "may_state_as_fact",
        "may_use_for_voice",
        "may_reveal_to_user"
      ],
      "title": "BehaviorPolicy",
      "type": "object"
    },
    "MemoryMetadata": {
      "additionalProperties": false,
      "properties": {
        "canon_status": {
          "enum": [
            "locked",
            "draft",
            "roadmap_private",
            "synthetic_behavioral",
            "non_canon_private",
            "poetic_private",
            "system_rule",
            "unknown"
          ],
          "title": "Canon Status",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "behavioral",
            "private_to_vuorse",
            "internal",
            "weaver_only"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Confidence"
        },
        "layer_affinity": {
          "anyOf": [
            {
              "enum": [
                "canon",
                "persona",
                "apocrypha",
                "ritual_logic",
                "roadmap_manifest",
                "hooplehopper_totality",
                "dialogue",
                "relationship_graph",
                "rule"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layer Affinity"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "canon_status",
        "visibility"
      ],
      "title": "MemoryMetadata",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a synthesized record came from, so the chaos lineage stays traceable.\n\nRoot records (walled atoms, hand-authored canon) leave this absent. Chaos\nEngine outputs must populate it. ``generation`` is the recursion depth:\nwalled atoms = 0, first crystallization = 1, an accept-and-recompound = 2,\netc. The Weaver review loop can then refuse to accept records past a\nchosen depth without explicit acknowledgement.",
      "properties": {
        "parent_atom_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Atom Ids",
          "type": "array"
        },
        "generation": {
          "default": 0,
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "RetrievalMetadata": {
      "additionalProperties": false,
      "properties": {
        "priority": {
          "maximum": 10,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "embedding_weight": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Embedding Weight",
          "type": "string"
        },
        "query_hints": {
          "items": {
            "type": "string"
          },
          "title": "Query Hints",
          "type": "array"
        }
      },
      "required": [
        "priority",
        "embedding_weight"
      ],
      "title": "RetrievalMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "layer": {
      "enum": [
        "canon",
        "persona",
        "apocrypha",
        "ritual_logic",
        "roadmap_manifest",
        "hooplehopper_totality",
        "dialogue",
        "relationship_graph",
        "rule"
      ],
      "title": "Layer",
      "type": "string"
    },
    "record_type": {
      "title": "Record Type",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/MemoryMetadata"
    },
    "retrieval": {
      "$ref": "#/$defs/RetrievalMetadata"
    },
    "behavior": {
      "$ref": "#/$defs/BehaviorPolicy"
    }
  },
  "required": [
    "id",
    "layer",
    "record_type",
    "title",
    "text",
    "metadata",
    "retrieval",
    "behavior"
  ],
  "title": "MemoryRecord",
  "type": "object"
}
