      "statements": [
        {
          "property": "glamoron-frame",
          "value": "To a Slayton particle, which behaves a lot like a photon, there is no experience of time: everything happens at once, simultaneously, and never at all.",
          "rank": "normal",
          "epistemic": "declared",
          "provenance": [
            {
              "source": "src:session-2026-09-26"
            }
          ]
        },
        {
          "property": "reading",
          "value": "This explains why the Charter's ratification is dated 'timeless': to a glamoron it is always being ratified. Glamorons are neither bosons nor fermions, and photons are bosons, so 'like a photon' means travelling like light, not being one.",
          "rank": "normal",
          "epistemic": "inference",
          "provenance": [
            {
              "source": "src:gray-eye"
            }
          ]
        }
      ]
    },
    {
      "id": "slayton-energy",
      "names_add": {
        "alternates": [
          "the Slayton field"
        ]
      },
      "related_add": [
        "gwingz-studio-ident",
        "glamorons"
      ],
      "statements": [
        {
          "property": "time",
          "value": "The Slayton field has no concept of linear time.",
          "rank": "normal",
          "epistemic": "declared",
          "provenance": [
            {
              "source": "src:session-2026-09-26"
            }
          ]
        },
        {
          "property": "activation",
          "value": "The Golden Path's 'activate Slayton energy like a solar panel in Ibiza' is enacted by the ident's Golden Hour flare, and by the Ibiza beach-house sting the Steward is composing for it.",
          "rank": "normal",
          "epistemic": "inference",
          "provenance": [
            {
              "source": "src:gray-eye"
            }
          ]
        }
      ]
    },
