{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PROJECT_DIR}/scripts/staleness-check.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -File scripts/scan-inventory.ps1:*)",
      "Bash(pwsh -NoProfile -File scripts/connect-comfyui.ps1:*)",
      "Bash(pwsh -NoProfile -File scripts/staleness-check.ps1:*)",
      "Bash(pwsh -NoProfile -File scripts/sync-skills.ps1:*)",
      "Bash(nvidia-smi:*)",
      "Bash(curl -s http://127.0.0.1:8188/*)",
      "Read(//d/ComfyUI312/ComfyUI/**)"
    ]
  }
}
