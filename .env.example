# VUORSE-VORTEX Environment Configuration
# Copy this file to .env and fill in the values.
# All variables are prefixed with VORTEX_

# ── Core ───────────────────────────────────────────────────────────────────
VORTEX_ARCHIVE_NAME=velvet-archive
VORTEX_UNIVERSE_LAYER=slayverse-prime

# ── Vector Database ────────────────────────────────────────────────────────
# Backend: chromadb or qdrant
VORTEX_VECTOR_BACKEND=chromadb

# ChromaDB connection
VORTEX_CHROMADB_HOST=localhost
VORTEX_CHROMADB_PORT=8000
VORTEX_CHROMADB_COLLECTION=vortex_memories

# Qdrant connection
VORTEX_QDRANT_HOST=localhost
VORTEX_QDRANT_PORT=6333
VORTEX_QDRANT_COLLECTION=vortex_memories
# VORTEX_QDRANT_API_KEY=your-qdrant-cloud-api-key

# ── Embedding ──────────────────────────────────────────────────────────────
VORTEX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VORTEX_EMBEDDING_BATCH_SIZE=64
VORTEX_EMBEDDING_DEVICE=cuda
VORTEX_EMBEDDING_DIMENSION=384

# ── GPU ────────────────────────────────────────────────────────────────────
VORTEX_REQUIRE_CUDA=true
VORTEX_CUDA_DEVICE_ID=0

# ── Synthetic Enrichment ───────────────────────────────────────────────────
VORTEX_ENRICHMENT_TEMPERATURE=0.85
VORTEX_ENRICHMENT_MAX_TOKENS=512
VORTEX_ENRICHMENT_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ── Canon Firewall ─────────────────────────────────────────────────────────
# Comma-separated list (JSON array format)
VORTEX_SEALED_CATEGORIES=["roadmap_manifest"]
VORTEX_FIREWALL_STRICT_MODE=true

# ── Paths ──────────────────────────────────────────────────────────────────
VORTEX_MANIFESTS_DIR=manifests
VORTEX_OUTPUT_DIR=output

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
VORTEX_LOG_LEVEL=INFO
# Log format: json (production) or console (development)
VORTEX_LOG_FORMAT=console
